# Copy to .env.deploy (git-ignored), fill in, then run:  ./scripts/link.sh
# It pushes every key to the right place: GitHub secrets/variables + Render env vars.

GITHUB_REPO=Damii-lola/3dGarments

# Supabase → Project Settings → General (Reference ID) and → API
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Password you chose when creating the project (Settings → Database to reset)
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Cloudflare → AI → Workers AI → "Use REST API" (token needs Workers AI: Read + Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Render → Account Settings → API Keys; service id is in the service URL (srv-...)
RENDER_API_KEY=
RENDER_SERVICE_ID=
API_URL=https://3dgarments-api.onrender.com
