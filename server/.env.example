# Copy to server/.env for local dev. On Render these are set in the dashboard.
PORT=8787
NODE_ENV=development

# Comma-separated list of allowed web origins (GitHub Pages origin, no path)
CORS_ORIGINS=http://localhost:5173,https://damii-lola.github.io

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=garments

# Cloudflare → AI → Workers AI → "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Optional: route through an AI Gateway for caching/analytics
CF_AI_GATEWAY_ID=

MAX_UPLOAD_MB=15
UPLOADS_PER_HOUR=60

# Optional, only used by `npm run verify`
API_URL=
